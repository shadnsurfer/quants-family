MODE=paper
# Robinhood Chain — verified live 2026-07-22 (chain id 4663 = 0x1237)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgres://quants:quants@localhost:5432/quants
# Pons (authoritative copy lives in data/chain/pons-abi.json; kept here for ops visibility)
PONS_FACTORY=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
PONS_LOCKER=0x736D76699C26D0d966744cAe304C000d471f7F35
# canonical WETH all pons pools quote against — verified on-chain (symbol()=WETH)
WETH_ADDR=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Uniswap v3 SwapRouter02 — factory() verified == our v3 factory; carries the chain's swap volume
SWAP_ROUTER_ADDR=0xCaf681a66D020601342297493863E78C959E5cb2
CHAINLINK_FEEDS_JSON=   # symbol→feed map (Phase 6)
X_TOKENS_JSON=          # per-quant OAuth creds — agent zero + children as they're born
KEYSTORE_PASSPHRASE=
# custody router (2026-08-09 doctrine, PROJECT.md §1.6): local = scrypt/AES keystore files on
# this host (season-0 default) · turnkey = per-quant keys created + signing inside Turnkey
# Nitro Enclaves — raw keys never exist on this host. Provision ids with
# scripts/turnkey-provision.mjs BEFORE flipping; births fail loudly for unprovisioned ids.
CUSTODY_MODE=local
TURNKEY_API_PUBLIC_KEY=     # org API keypair — authorizes signing REQUESTS, cannot export keys
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORG_ID=
# dust testing only (M5): a THROWAWAY funded key, never the treasury key. Secrets go in .env, never here.
DUST_PRIVATE_KEY=
